    },
    "q13": {
      "id": "q13",
      "type": "question",
      "kind": "risk",
      "title": "What are the security, privacy, and failure risks?",
      "body": "- Does it touch auth, permissions, secrets, or personal data; what is the threat model?\n- What happens on partial failure, timeouts, retries, or bad input?\n- Performance or cost impact at current and 10x scale?",
      "status": "active",
