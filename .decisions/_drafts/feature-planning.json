        "type": "human"
      },
      "created_at": "2026-10-11T22:38:36Z",
      "updated_at": "2026-10-11T22:38:36Z"
    },
    "q5": {
      "id": "q5",
      "type": "question",
      "kind": "what",
      "title": "What does success look like, and how is it measured?",
      "body": "- Propose 1-3 measurable metrics with a baseline and target.\n- How and where is each metric collected, and when is it reviewed?\n- What result would make us roll back or abandon the feature?",
      "status": "pending",
      "parent": "q4",
      "pros": [],
      "cons": [],
      "rationale": "",
      "assignee": "human",
      "chosen": null,
      "links": [],
