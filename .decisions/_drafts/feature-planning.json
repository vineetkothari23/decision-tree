        "type": "human"
      },
      "created_at": "2026-10-11T22:38:36Z",
      "updated_at": "2026-10-11T22:38:36Z"
    },
    "q3": {
      "id": "q3",
      "type": "question",
      "kind": "who",
      "title": "Who uses it, and who has a stake in it?",
      "body": "- Which user segments or roles are affected, and how many?\n- Who owns the decision, who reviews it, who supports it after launch?\n- Which other teams or services depend on the parts we touch?",
      "status": "active",
      "parent": "g1",
      "pros": [],
      "cons": [],
      "rationale": "",
      "assignee": "",
      "chosen": null,
      "links": [],
      "comments": [],
      "history": [],
      "created_by": {
        "name": "human",
        "type": "human"
      },
      "created_at": "2026-10-11T22:38:36Z",
      "updated_at": "2026-10-11T22:38:36Z"
    },
    "q4": {
      "id": "q4",
      "type": "question",
      "kind": "what",
      "title": "What is in scope, and what is explicitly out?",
      "body": "- List the smallest version that delivers the outcome; everything else is out or later.\n- Which edge cases, platforms, locales or plans are excluded on purpose?\n- What existing behavior must not change?",
      "status": "active",
      "parent": "g1",
      "pros": [],
      "cons": [],
      "rationale": "",
      "assignee": "",
      "chosen": null,
      "links": [],
      "comments": [],
