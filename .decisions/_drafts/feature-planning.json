        "type": "human"
      },
      "created_at": "2026-10-11T22:38:36Z",
      "updated_at": "2026-10-11T22:38:36Z"
    },
    "q12": {
      "id": "q12",
      "type": "question",
      "kind": "how",
      "title": "How will we test it?",
      "body": "- Which unit, integration, and end-to-end tests prove the success criteria?\n- Which existing tests cover the code we change, and which gaps must be filled first?\n- What needs manual or staged verification (UI, real integrations, load)?",
      "status": "active",
      "parent": "g1",
      "pros": [],
      "cons": [],
      "rationale": "",
      "assignee": "",
      "chosen": null,
      "links": [],
