    },
    "q2": {
      "id": "q2",
      "type": "question",
      "kind": "why",
      "title": "Why build this, and why now?",
      "body": "- What problem does it solve, and what evidence shows it is real (tickets, data, requests)?\n- What happens if we do nothing, or do it next quarter?\n- Is this the root problem, or a symptom of something cheaper to fix?",
      "status": "active",
      "parent": "g1",
      "pros": [],
      "cons": [],
      "rationale": "",
      "assignee": "",
      "chosen": null,
      "links": [],
