    },
    "o10": {
      "id": "o10",
      "type": "option",
      "kind": null,
      "title": "Ship behind a feature flag",
      "body": "",
      "status": "active",
      "parent": "q9",
      "pros": [
        "Gradual rollout and instant rollback",
        "Can merge incomplete work safely",
        "Enables A/B measurement"
      ],
      "cons": [
        "Two code paths to test and maintain",
        "Flag must be cleaned up later",
        "Needs flag infrastructure"
      ],
      "rationale": "",
      "assignee": "",
      "chosen": null,
      "links": [],
      "comments": [],
      "history": [],
      "created_by": {
        "name": "human",
        "type": "human"
      },
      "created_at": "2026-10-11T22:38:36Z",
      "updated_at": "2026-10-11T22:38:36Z"
    },
    "o11": {
      "id": "o11",
      "type": "option",
      "kind": null,
      "title": "Big-bang release",
      "body": "",
      "status": "active",
      "parent": "q9",
      "pros": [
        "Single code path",
        "No flag cleanup",
        "Simplest for small or internal changes"
      ],
      "cons": [
        "All users exposed at once",
        "Rollback means a redeploy or revert",
        "Hard to measure impact in isolation"
      ],
      "rationale": "",
      "assignee": "",
      "chosen": null,
      "links": [],
      "comments": [],
      "history": [],
      "created_by": {
