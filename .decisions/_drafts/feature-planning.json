      },
      "created_at": "2026-10-11T22:38:36Z",
      "updated_at": "2026-10-11T22:38:36Z"
    },
    "q6": {
      "id": "q6",
      "type": "question",
      "kind": "how",
      "title": "How should we build it?",
      "body": "- Compare at least two approaches, including build vs. buy/reuse an existing library or service.\n- Which existing patterns in the codebase does each approach follow or break?\n- Rough effort, maintenance cost, and reversibility of each.",
      "status": "active",
      "parent": "g1",
      "pros": [],
      "cons": [],
      "rationale": "",
      "assignee": "",
      "chosen": null,
      "links": [],
      "comments": [],
      "history": [],
      "created_by": {
        "name": "human",
        "type": "human"
      },
      "created_at": "2026-10-11T22:38:36Z",
      "updated_at": "2026-10-11T22:38:36Z"
    },
    "q7": {
      "id": "q7",
      "type": "question",
      "kind": "how",
      "title": "What data model and API changes are needed?",
      "body": "- New or changed tables, fields, events, config; are any migrations destructive?\n- New or changed endpoints, payloads, or public interfaces; are they backwards compatible?\n- Who else consumes these contracts, and how are they versioned?",
      "status": "active",
      "parent": "q6",
      "pros": [],
      "cons": [],
      "rationale": "",
      "assignee": "",
      "chosen": null,
      "links": [],
      "comments": [],
      "history": [],
      "created_by": {
        "name": "human",
        "type": "human"
      },
      "created_at": "2026-10-11T22:38:36Z",
      "updated_at": "2026-10-11T22:38:36Z"
    },
    "q8": {
      "id": "q8",
      "type": "question",
      "kind": "where",
      "title": "Where does it live in the codebase and architecture?",
      "body": "- Which modules, services, or packages change; which new ones (if any) are created?\n- Which layer owns the logic (UI, API, worker, database), and why there?\n- Does it add coupling between components that are currently independent?",
      "status": "active",
      "parent": "g1",
      "pros": [],
      "cons": [],
      "rationale": "",
      "assignee": "",
      "chosen": null,
      "links": [],
      "comments": [],
      "history": [],
      "created_by": {
        "name": "human",
        "type": "human"
      },
      "created_at": "2026-10-11T22:38:36Z",
      "updated_at": "2026-10-11T22:38:36Z"
    },
    "q9": {
      "id": "q9",
      "type": "question",
      "kind": "when",
      "title": "How does it reach users, and in what order?",
      "body": "- Sequence the work so each step is shippable and reviewable on its own.\n- What must be migrated or backfilled, and can it run before the code ships?\n- How is it rolled back if something goes wrong after release?",
      "status": "active",
      "parent": "g1",
      "pros": [],
      "cons": [],
      "rationale": "",
